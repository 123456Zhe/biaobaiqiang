DATABASE_URL="file:./prisma/dev.db"
# 生产环境必须改成强随机值；以下示例值会被启动校验拒绝，服务将无法启动。
ADMIN_PASSWORD="admin123"
SESSION_SECRET="please-change-this"
WECHAT_TOKEN=""
PUBLIC_SITE_URL="http://localhost:3000"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_VISION_MODEL=""
OPENAI_REASONING_EFFORT=""
OPENAI_MODERATION_TIMEOUT_MS="15000"
OPENAI_MODERATION_RETRIES="2"
# 图片审核：单张超时（毫秒）、重试次数（默认 0，失败直接转人工复审）、并发上限（默认 3）
OPENAI_VISION_TIMEOUT_MS="30000"
OPENAI_VISION_RETRIES="0"
OPENAI_IMAGE_CONCURRENCY="3"
